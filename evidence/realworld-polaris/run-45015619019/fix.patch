 // submission do not: a connected wallet (Freighter) builds, simulates,
 // signs, and sends its own transactions directly against Soroban RPC — see
 // lib/freighter-wallet.ts. Both RPC values below are public network
-// parameters, not secrets — safe to bake in as defaults the same way
-// oracleUrl already is.
+// parameters, not secrets.
+//
+// Next.js inlines NEXT_PUBLIC_* at build time, so each one must be read as a
+// literal process.env.NEXT_PUBLIC_... expression. The localhost/testnet
+// defaults are for development only; a production build must set every
+// variable explicitly rather than silently ship localhost or testnet.
+const values = {
+  NEXT_PUBLIC_ORACLE_URL: process.env.NEXT_PUBLIC_ORACLE_URL,
+  NEXT_PUBLIC_STELLAR_RPC_URL: process.env.NEXT_PUBLIC_STELLAR_RPC_URL,
+  NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE: process.env.NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE,
+};
+
+if (process.env.NODE_ENV === 'production') {
+  const missing = Object.entries(values)
+    .filter(([, value]) => !value)
+    .map(([name]) => name);
+  if (missing.length > 0) {
+    throw new Error(
+      `Missing required environment variable(s) for a production build: ${missing.join(', ')}. ` +
+        'Set them explicitly; the localhost/testnet defaults are for development only.',
+    );
+  }
+}
+
 export const config = {
-  oracleUrl: process.env.NEXT_PUBLIC_ORACLE_URL ?? 'http://localhost:3001',
-  stellarRpcUrl: process.env.NEXT_PUBLIC_STELLAR_RPC_URL ?? 'https://soroban-testnet.stellar.org',
-  stellarNetworkPassphrase: process.env.NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE ?? 'Test SDF Network ; September 2015',
+  oracleUrl: values.NEXT_PUBLIC_ORACLE_URL || 'http://localhost:3001',
+  stellarRpcUrl: values.NEXT_PUBLIC_STELLAR_RPC_URL || 'https://soroban-testnet.stellar.org',
+  stellarNetworkPassphrase: values.NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE || 'Test SDF Network ; September 2015',
 };
