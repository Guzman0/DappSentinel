{
  "_about": "Checks that work on any public dApp URL, with no changes to its code. Run: node bin/dappsentinel.js check --config profiles/live --url https://your-dapp.xyz",
  "url": "https://app.example.xyz",
  "chainId": 1,
  "allowedScriptHosts": [
    "self"
  ],
  "testnetHints": [
    "sepolia",
    "goerli",
    "holesky",
    "hoodi",
    "testnet",
    "devnet",
    "staging",
    "localhost",
    "127.0.0.1"
  ],
  "rpcKeyProviders": [
    "alchemy.com",
    "infura.io",
    "quiknode.pro",
    "ankr.com",
    "chainstack.com",
    "drpc.org",
    "blastapi.io",
    "helius-rpc.com"
  ],
  "secretKeyNames": [
    "pk",
    "privateKey",
    "private_key",
    "wallet_pk",
    "secretKey",
    "mnemonic",
    "seed",
    "seedPhrase",
    "seed_phrase"
  ],
  "timeoutSeconds": 240,
  "maxSteps": 20,
  "checksDir": "checks"
}
