{
  "name": "dappsentinel",
  "version": "1.3.0",
  "description": "A pre-launch safety gate for dApp frontends. Kane CLI catches leaked RPC keys, testnet endpoints, wrong contract addresses, untrusted scripts and keys in storage, checks that what users see is what their wallet is asked to sign, and your coding agent fixes it before you ship.",
  "homepage": "https://github.com/Guzman0/DappSentinel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guzman0/DappSentinel.git"
  },
  "bugs": {
    "url": "https://github.com/Guzman0/DappSentinel/issues"
  },
  "bin": {
    "dappsentinel": "bin/dappsentinel.js"
  },
  "files": [
    "bin/",
    "lib/",
    "profiles/",
    "checks/",
    "sentinel.config.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "demo": "node bin/dappsentinel.js serve",
    "sentinel": "node bin/dappsentinel.js check",
    "sentinel:headed": "node bin/dappsentinel.js check --headed",
    "checks": "node bin/dappsentinel.js list",
    "deploy": "node bin/dappsentinel.js check && netlify deploy --prod --dir demo-dapp",
    "test": "node test/analyzers.test.js",
    "demo:reset": "git checkout -- demo-dapp"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "cross-spawn": "^7.0.6",
    "ws": "^8.23.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "web3",
    "dapp",
    "security",
    "kane-cli",
    "testing",
    "claude-code",
    "wallet",
    "ethereum",
    "pre-launch"
  ],
  "author": "Guzman",
  "license": "MIT"
}
